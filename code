# 9. MAIN GENERATION ENGINE
# ================================================================

def generate_wordlist():
    start_time = time.time()

    profile = get_profile()

    if not profile:
        raise ValueError(
            "Please enter at least one profile/custom word."
        )

    min_len = max(1, safe_int(min_length.value, 4))
    max_len = max(min_len, safe_int(max_length.value, 32))
    limit = max(10, safe_int(max_words.value, 5000))

    generated = set()

    def add(value):
        add_word(
            generated,
            value,
            min_len,
            max_len,
            limit
        )

    # ------------------------------------------------------------
    # Base variants
    # ------------------------------------------------------------

    for word in profile:

        add(word)

        if lowercase.value:
            add(word.lower())

        if uppercase.value:
            add(word.upper())

        if capitalized.value:
            add(word.capitalize())

        if reverse_words.value:
            add(word[::-1])

        if leet.value:
            add(make_leet(word))

        if leet.value:
            add(make_leet(word.lower()))

    # ------------------------------------------------------------
    # Dates / Years
    # ------------------------------------------------------------

    date_list = date_tokens()

    if dates.value:

        for base in profile:

            for token in date_list:

                add(base + token)
                add(token + base)

                if combinations.value:
                    for sep in normalize_list(separator_patterns.value):
                        add(base + sep + token)
                        add(token + sep + base)

    # ------------------------------------------------------------
    # Number patterns
    # ------------------------------------------------------------

    nums = normalize_list(number_patterns.value)

    if numbers.value:

        for base in profile:

            for number in nums:

                add(base + number)
                add(number + base)

                if capitalized.value:
                    add(base.capitalize() + number)

                if uppercase.value:
                    add(base.upper() + number)

                if leet.value:
                    add(make_leet(base) + number)

    # ------------------------------------------------------------
    # Symbol patterns
    # ------------------------------------------------------------

    syms = normalize_list(symbol_patterns.value)

    if symbols.value:

        for base in profile:

            for symbol in syms:

                add(base + symbol)
                add(symbol + base)

                for number in nums[:20]:

                    add(base + symbol + number)
                    add(base + number + symbol)

    # ------------------------------------------------------------
    # Two-word combinations
    # ------------------------------------------------------------

    if combinations.value:

        separators = normalize_list(separator_patterns.value)

        if not separators:
            separators = [""]

        for a, b in itertools.permutations(profile, 2):

            add(a + b)
            add(b + a)

            for sep in separators:

                add(a + sep + b)
                add(b + sep + a)

                if numbers.value:
                    for number in nums[:10]:
                        add(a + sep + b + number)
                        add(number + a + sep + b)

    # ------------------------------------------------------------
    # Extra capitalization combinations
    # ------------------------------------------------------------

    snapshot = list(generated)

    for word in snapshot[:min(len(snapshot), 5000)]:

        if len(generated) >= limit:
            break

        if lowercase.value:
            add(word.lower())

        if uppercase.value:
            add(word.upper())

        if capitalized.value:
            add(word.capitalize())

        if reverse_words.value:
            add(word[::-1])

    # ------------------------------------------------------------
    # Final processing
    # ------------------------------------------------------------

    result = list(generated)

    if deduplicate.value:
        result = list(dict.fromkeys(result))

    result.sort(key=lambda x: (len(x), x.lower()))

    result = result[:limit]

    elapsed = time.time() - start_time

    STATE["words"] = result
    STATE["filtered"] = result.copy()
    STATE["generation_time"] = elapsed
    STATE["generated_at"] = datetime.now().isoformat()
    STATE["profile"] = {
        "words": profile,
        "min_length": min_len,
        "max_length": max_len,
        "max_words": limit
    }

    return result


