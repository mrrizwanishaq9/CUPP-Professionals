def render_words(words=None):
    if words is None:
        words = STATE["filtered"]

    with word_output:
        clear_output(wait=True)

        if not words:
            display(HTML("""
            <div class="cupp-console">
                No matching words.
            </div>
            """))
            return

        visible = words[:5000]

        text = "\n".join(
            f"{i+1:05d}  {word}"
            for i, word in enumerate(visible)
        )

        display(HTML(
            "<pre style='color:#b9ffe6;"
            "background:#040a0f;"
            "padding:12px;"
            "border-radius:8px;'>"
            + text.replace("&", "&amp;")
            .replace("<", "&lt;")
            .replace(">", "&gt;")
            + "</pre>"
        ))


def refresh_logs():
    if "logs_output" not in globals():
        return

    with logs_output:
        clear_output(wait=True)

        text = "\n".join(STATE["logs"][-100:])

        display(HTML(
            "<pre style='color:#9fffd8;"
            "background:#040a0f;"
            "padding:10px;"
            "border-radius:8px;'>"
            + text
            + "</pre>"
        ))


def refresh_analytics():
    with analytics_output:
        clear_output(wait=True)

        words = STATE["words"]

        if not words:
            display(HTML(
                "<div class='cupp-console'>"
                "No generated data yet."
                "</div>"
            ))
            return

        lengths = Counter(len(x) for x in words)

        rows = ""

        for length, count in sorted(lengths.items()):
            rows += f"""
            <tr>
                <td>{length}</td>
                <td>{count:,}</td>
            </tr>
            """

        display(HTML(f"""
        <div class="cupp-console">
        <b>WORD LENGTH DISTRIBUTION</b>
        <br><br>

        <table style="width:100%; color:#b9ffe6;">
            <tr>
                <th align="left">Length</th>
                <th align="left">Count</th>
            </tr>
            {rows}
        </table>
        </div>
        """))


