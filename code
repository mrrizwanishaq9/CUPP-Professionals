def get_profile():
    fields = [
        first_name.value,
        last_name.value,
        nickname.value,
        partner.value,
        pet.value,
        company.value,
        city.value,
        keyword.value,
    ]

    values = []

    for item in fields:
        item = item.strip()
        if item:
            values.append(item)

    values.extend(normalize_list(custom_words.value))

    return list(dict.fromkeys(values))


def date_tokens():
    result = []

    raw = birthday.value.strip()

    if raw:
        result.append(raw)

        digits = re.sub(r"\D", "", raw)

        if len(digits) >= 4:
            result.append(digits[-4:])

        if len(digits) >= 6:
            result.append(digits[:6])

        if len(digits) >= 8:
            result.append(digits[-8:])

    start = safe_int(year_from.value, 1990)
    end = safe_int(year_to.value, 2026)

    if start > end:
        start, end = end, start

    end = min(end, start + 150)

    for year in range(start, end + 1):
        result.append(str(year))

    return list(dict.fromkeys(result))


def parse_leet_map():
    mapping = {}

    for part in leet_map.value.split(","):
        if "=" not in part:
            continue

        left, right = part.split("=", 1)

        left = left.strip()
        right = right.strip()

        if left:
            mapping[left] = right

    return mapping


def make_leet(word):
    mapping = parse_leet_map()

    result = word

    for source, target in mapping.items():
        result = result.replace(source, target)
        result = result.replace(source.upper(), target)

    return result


