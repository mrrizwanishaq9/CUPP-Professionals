def on_generate_clicked(button=None):
    try:

        status_html.value = """
        <div class="cupp-console">
        ⚡ GENERATING — Please wait...
        </div>
        """

        generate_button.disabled = True

        result = generate_wordlist()

        refresh_kpis()
        render_words()
        refresh_analytics()

        status_html.value = f"""
        <div class="cupp-console">
        <span style="color:#00ff9d;">
        ✅ GENERATION COMPLETE
        </span><br>
        Generated: <b>{len(result):,}</b> words<br>
        Time: <b>{STATE["generation_time"]:.3f}s</b>
        </div>
        """

        log(
            f"Generated {len(result):,} words "
            f"in {STATE['generation_time']:.3f}s",
            "OK"
        )

    except Exception as exc:

        status_html.value = f"""
        <div class="cupp-console">
        <span style="color:#ff5577;">
        ❌ ERROR
        </span><br>
        {str(exc)}
        </div>
        """

        log(str(exc), "ERROR")

    finally:
        generate_button.disabled = False


