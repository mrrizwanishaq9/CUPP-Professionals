def apply_preset(change):

    selected = change["new"]

    if selected == "Balanced Lab":

        min_length.value = 4
        max_length.value = 24
        max_words.value = 5000

        lowercase.value = True
        uppercase.value = True
        capitalized.value = True
        reverse_words.value = True
        leet.value = True
        numbers.value = True
        symbols.value = True
        dates.value = True
        combinations.value = True
        deduplicate.value = True

    elif selected == "Compact Lab":

        min_length.value = 5
        max_length.value = 18
        max_words.value = 1500

        lowercase.value = True
        uppercase.value = False
        capitalized.value = True
        reverse_words.value = False
        leet.value = False
        numbers.value = True
        symbols.value = False
        dates.value = True
        combinations.value = True
        deduplicate.value = True

    elif selected == "Extended Lab":

        min_length.value = 4
        max_length.value = 32
        max_words.value = 15000

        lowercase.value = True
        uppercase.value = True
        capitalized.value = True
        reverse_words.value = True
        leet.value = True
        numbers.value = True
        symbols.value = True
        dates.value = True
        combinations.value = True
        deduplicate.value = True

    log(f"Preset selected: {selected}", "CONFIG")


preset.observe(apply_preset, names="value")


