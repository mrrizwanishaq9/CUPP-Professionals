def export_txt(button=None):

    with open(TXT_FILE, "w", encoding="utf-8") as f:
        f.write("\n".join(STATE["words"]))

    log(f"TXT exported: {TXT_FILE}", "EXPORT")

    display(HTML(
        f"<div class='cupp-console'>"
        f"✅ TXT saved: {TXT_FILE}"
        f"</div>"
    ))


def export_csv(button=None):

    with open(
        CSV_FILE,
        "w",
        newline="",
        encoding="utf-8"
    ) as f:

        writer = csv.writer(f)

        writer.writerow(["index", "word", "length"])

        for index, word in enumerate(
            STATE["words"],
            start=1
        ):
            writer.writerow([
                index,
                word,
                len(word)
            ])

    log(f"CSV exported: {CSV_FILE}", "EXPORT")

    display(HTML(
        f"<div class='cupp-console'>"
        f"✅ CSV saved: {CSV_FILE}"
        f"</div>"
    ))


def export_json(button=None):

    session = {
        "application": APP_NAME,
        "version": VERSION,
        "generated_at": STATE["generated_at"],
        "generation_time": STATE["generation_time"],
        "profile": STATE["profile"],
        "total_words": len(STATE["words"]),
        "words": STATE["words"],
        "logs": STATE["logs"]
    }

    with open(
        JSON_FILE,
        "w",
        encoding="utf-8"
    ) as f:

        json.dump(
            session,
            f,
            indent=2,
            ensure_ascii=False
        )

    log(f"JSON exported: {JSON_FILE}", "EXPORT")

    display(HTML(
        f"<div class='cupp-console'>"
        f"✅ JSON saved: {JSON_FILE}"
        f"</div>"
    ))


