def log(message, level="INFO"):
    stamp = datetime.now().strftime("%H:%M:%S")
    STATE["logs"].append(f"[{stamp}] [{level}] {message}")
    if len(STATE["logs"]) > 300:
        STATE["logs"] = STATE["logs"][-300:]
    refresh_logs()

def safe_int(value, default):
    try:
        return int(value)
    except Exception:
        return default


def normalize_list(text):
    if not text:
        return []

    parts = re.split(r"[\n,;]+", text)

    result = []
    for item in parts:
        item = item.strip()
        if item:
            result.append(item)

    return result


def valid_length(word, min_len, max_len):
    return min_len <= len(word) <= max_len


def add_word(container, word, min_len, max_len, limit):
    if len(container) >= limit:
        return

    word = str(word).strip()

    if not word:
        return

    if not valid_length(word, min_len, max_len):
        return

    container.add(word)


